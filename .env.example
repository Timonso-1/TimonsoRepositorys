# Copy this file to .env.local and fill in your values.

# Required: GitHub user whose public repositories are shown.
GITHUB_USERNAME=your-github-username

# Optional: personal access token (no scopes needed for public data).
# Raises the API rate limit from 60 to 5000 requests per hour and enables the
# contribution heatmap and the "Beiträge zu Organisationen" section (GraphQL).
GITHUB_TOKEN=

# Optional: number of repositories to show (1-100, default 10).
GITHUB_REPO_LIMIT=10

# Optional: seconds until the cached GitHub response is refreshed (default 3600).
GITHUB_REVALIDATE_SECONDS=3600

# Optional: site title (header and browser tab).
SITE_TITLE=Meine Projekte

# Optional: name shown in the footer copyright; leave empty to hide it.
SITE_COPYRIGHT_HOLDER=Timonso

# Optional: contact email shown in the footer; leave empty to hide it.
SITE_CONTACT_EMAIL=

# Optional: URL of this website's source code repository; leave empty to hide the link.
SITE_SOURCE_URL=
